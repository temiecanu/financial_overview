    <dashboard enable-sort-zone-taborder='true' name='📋 How to?'>
      <repository-location derived-from='https://haproxy-traffic-splitter/workbooks/financial_overview_17501448537580/Howto?rev=' id='Howto' path='/workbooks/financial_overview_17501448537580' revision='' />
      <style />
      <size maxheight='1800' maxwidth='1200' minheight='1800' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='30' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='100000' id='28' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone forceUpdate='true' h='100000' id='5' type-v2='text' w='100000' x='0' y='0'>
                <formatted-text>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='13'>1. General Information</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Title:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Financial Overview</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Dashboard Owner:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Artemie Țurcanu (Data Analyst)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Purpose:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>This dashboard provides an overview of key product sales metrics in the beauty category: revenue, sales, price, buyout rate, and MoM dynamics. It enables users to:</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Identify the most profitable and underperforming categories</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Track trends by category, brand, country, and product</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Compare metrics between months</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Quickly assess the current sales performance and assortment effectiveness</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Primary Stakeholder:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Sales and Analytics Department</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Metrics:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Revenue (December, November)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Sales (December, November)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Price (December, November)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Buyout Rate</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• MoM dynamics</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Dimensions:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Category</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Brand</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Product</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Country</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Month</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='13'>2. Data Sources and Technical Details</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Data Sources:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• </run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Products</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> (data.xlsx): includes product category, brand, price, sales, and revenue</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• </run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Dynamic</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> (data.xlsx): includes brand-level dynamics (month, sales, revenue, buyout rate)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Join Structure:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>The two sheets from the data.xlsx file — Products and Dynamic — were joined using an inner join on the Brand field. This join ensures that only records present in both tables are included in the visualisations.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• </run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Join key: </run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Brand</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• </run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Join type: </run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Inner join</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>This join was applied during data source setup in Tableau before building the dashboards.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Connection Type:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Manual import</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Calculation Notes:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• MoM and Buyout Rate are calculated using manually aggregated expressions</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Custom parameters are used for dynamic filtering</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='13'>3. Frequently Asked Questions (FAQ)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Why is the KPI indicator not showing data for the selected brand?</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>The brand’s sales volume might be too small to register on the scale of the chart. The value may be rounded visually to zero — this applies to both revenue and unit sales.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Why do values on the charts differ from the table values?</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Charts display aggregated and rounded data, while tables reflect precise values. In addition, some charts may show only top-performing categories or brands, whereas tables list the full dataset.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='13'>4. Dashboard Structure</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Top section:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> KPI blocks (Revenue, Sales, Average Buyout Rate)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Line plots:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> Metric dynamics over months</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Bar chart:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> Top products by average price in the current month</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Table:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> Breakdown by brand, category, and product</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Scatter plot:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> Relationship between average price and buyout rate</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Pie charts:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> Revenue shares by category and country with dynamic grouping</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Map:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> Average product price by country for the current month</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>Bubble chart:</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'> Sales volume by brand</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12'>Filters available for:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Category</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Brand</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Country</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='11'>• Month</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='padding' value='15' />
                  <format attr='background-color' value='#333333f4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='0' />
          </zone-style>
        </zone>
        <zone h='1278' id='23' type-v2='dashboard-object' w='14750' x='84000' y='1111'>
          <button action='tabdoc:goto-sheet window-id=&quot;{4B15AFD7-CCA9-4CA5-8360-7C93A36F0B41}&quot;' button-type='text'>
            <button-visual-state>
              <caption>Back to Dashboard</caption>
              <button-caption-font-style bold='true' fontcolor='#f5f5f5' fontname='Tableau Light' fontsize='12' />
              <format attr='background-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='3' />
              <format attr='border-color' value='#b4b4b4' />
            </button-visual-state>
          </button>
        </zone>
      </zones>
