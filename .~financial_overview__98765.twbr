              <calculation class='tableau' formula='IF SUM([Revenue (December)]) - SUM([Revenue (November)]) &gt; 0 THEN&#10;    &quot;▲ &quot; + &#10;    STR(ROUND(((SUM([Revenue (December)]) - SUM([Revenue (November)])) &#10;               / SUM([Revenue (November)])) * 100, 2)) + &quot;% MoM&quot;&#10;ELSE&#10;    &quot;▼ &quot; + &#10;    STR(ROUND(((SUM([Revenue (December)]) - SUM([Revenue (November)])) &#10;               / SUM([Revenue (November)])) * 100, 2)) + &quot;% MoM&quot;&#10;END' />
            </column>
