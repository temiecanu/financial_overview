      <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
      <column caption='Buyout rate (December) Tooltip' datatype='real' name='[Buyout rate (December) (copy)_737253352409649157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Buyout rate (December)]' />
      </column>
      <column datatype='real' name='[Buyout rate (December)]' role='measure' type='quantitative' />
      <column caption='Buyout rate Tooltip' datatype='real' name='[Buyout rate (copy)_737253352405123074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Buyout rate]' />
      </column>
      <column caption='Revenue Share' datatype='real' default-format='p0%' name='[Calculation_1009158177778843648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue (December)]) / TOTAL(SUM([Revenue (December)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pie Group' datatype='string' name='[Calculation_1009158177790279683]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Category&apos; THEN [Category]&#10;WHEN &apos;Country&apos; THEN [Country]&#10;END' />
      </column>
      <column caption='Revenue MoM Change Colour' datatype='string' name='[Calculation_1647965634587049986]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Revenue (December)]) - SUM([Revenue (November)]) &gt; 0 THEN &quot;Positive&quot;&#10;ELSE &quot;Negative&quot;&#10;END' />
      </column>
      <column caption='Revenue MoM' datatype='real' name='[Calculation_270567838182830080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Revenue (December)] - [Revenue (November)]) / [Revenue (November)]' />
